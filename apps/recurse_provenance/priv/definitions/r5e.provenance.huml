%HUML v0.2.0
# Provenance v2 base kinds (provenance.r5e.io/v2).
#
# The vocabulary is the October 30 contract's. The four kinds that carry
# content extend Core's Artifact; the rest are plain events.

format: "r5e.contract-package/v2"
package: "r5e.provenance"
group: "provenance.r5e.io"
version: "v2"
imports::
  core: "r5e.core"

types::
  Position::
    type: "integer"
    minimum: 1

  ResponseOutcome::
    type: "string"
    enum:: "completed", "failed", "denied", "cancelled", "partial", "unknown"

  SessionOutcome::
    type: "string"
    enum:: "completed", "interrupted", "failed", "unknown"

  Details::
    type: "object"
    description: "Issuer-defined detail: up to 64 named scalars. Nothing in it is interpreted by the base kinds, and nothing in it is content; content goes behind a reference."
    keys: "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
    maxEntries: 64
    values::
      type:: "string", "integer", "boolean"
      maxLength: 2048

  FrontierEntry::
    type: "object"
    additionalProperties: false
    required:: "stream", "seq", "event"
    properties::
      stream::
        use: "core.IdentityUri"
      seq::
        use: "Position"
      event::
        use: "core.EvidenceRef"

  Frontier::
    type: "array"
    unique: true
    items::
      use: "FrontierEntry"

  PolicyEvaluation::
    type: "object"
    description: "One evaluation of one exact policy against exact inputs."
    additionalProperties: false
    required:: "policyRef", "outcome", "inputRefs"
    nonEmpty::
      - "reason"
    properties::
      policyRef::
        use: "core.ExactRef"
      outcome::
        type: "string"
        enum:: "allow", "deny", "error"
      inputRefs::
        type: "array"
        unique: true
        items::
          use: "core.ExactRef"
      evaluatorRef::
        use: "core.ExactRef"
      decisionRef::
        use: "core.EvidenceRef"
      activationRef::
        use: "core.ExactRef"
      reason::
        type: "string"

  CallResult::
    type: "object"
    description: "What the issuer itself did with a call, when that is known as the call is recorded."
    additionalProperties: false
    required:: "outcome", "outputRefs"
    nonEmpty::
      - "reason"
    properties::
      outcome::
        use: "ResponseOutcome"
      outputRefs::
        type: "array"
        unique: true
        items::
          use: "core.ExactRef"
      reason::
        type: "string"
      completedAt::
        use: "core.Timestamp"

  Snapshot::
    type: "object"
    additionalProperties: false
    required:: "stateRef", "schemaRef", "interpretationRef", "queryRef", "at"
    properties::
      stateRef::
        use: "core.BytesRef"
      schemaRef::
        use: "core.BytesRef"
      interpretationRef::
        use: "core.BytesRef"
      queryRef::
        use: "core.BytesRef"
      at::
        use: "Frontier"

kinds::

  # -- Content-carrying kinds: each is an Artifact ---------------------------

  ModelCall::
    extends: "core.r5e.io/v1/Artifact"
    description: "A request sent to a model. Its content is the exact request body."
    schema::
      required:: "provider", "model"
      nonEmpty:: "provider", "model"
      properties::
        provider::
          type: "string"
        model::
          type: "string"
        policy::
          use: "PolicyEvaluation"
        retryOf::
          use: "core.EvidenceRef"
        details::
          use: "Details"
        result::
          use: "CallResult"

  ModelResponse::
    extends: "core.r5e.io/v1/Artifact"
    description: "What a model returned. Its content is the exact response bytes."
    schema::
      required::
        - "outcome"
      nonEmpty::
        - "reason"
      properties::
        outcome::
          use: "ResponseOutcome"
        call::
          use: "core.EvidenceRef"
        reason::
          type: "string"
        details::
          use: "Details"

  ToolCall::
    extends: "core.r5e.io/v1/Artifact"
    description: "A tool call a model proposed. Its content is the exact arguments."
    schema::
      required::
        - "tool"
      nonEmpty:: "tool", "callId"
      properties::
        tool::
          type: "string"
        callId::
          type: "string"
          description: "The identifier the model or the caller gave this call, when it gave one."
          maxLength: 256
        policy::
          use: "PolicyEvaluation"
        retryOf::
          use: "core.EvidenceRef"
        details::
          use: "Details"
        result::
          use: "CallResult"

  ToolResult::
    extends: "core.r5e.io/v1/Artifact"
    description: "What a tool returned, said of one recorded call. Its content is the exact output."
    schema::
      required:: "outcome", "call"
      nonEmpty:: "reason", "callId"
      properties::
        outcome::
          use: "ResponseOutcome"
        call::
          use: "core.EvidenceRef"
          description: "The ToolCall record this is the result of."
        callId::
          type: "string"
          description: "The identifier the result was returned under, when there was one."
          maxLength: 256
        reason::
          type: "string"
        details::
          use: "Details"

  # -- Events ------------------------------------------------------------------

  PolicyDecision::
    substrate: "event"
    naming::
      mode: "content"
    description: "A policy evaluation recorded on its own, about a named subject."
    schema::
      additionalProperties: false
      required:: "subject", "evaluation"
      properties::
        subject::
          use: "core.ExactRef"
        evaluation::
          use: "PolicyEvaluation"
        details::
          use: "Details"

  SessionOpened::
    substrate: "event"
    naming::
      mode: "content"
    description: "A session began, or continued from another."
    schema::
      additionalProperties: false
      required::
        - "session"
      properties::
        session::
          use: "core.IdentityUri"
        continues::
          use: "core.IdentityUri"
        contextRefs::
          type: "array"
          unique: true
          items::
            use: "core.ExactRef"
        details::
          use: "Details"

  SessionClosed::
    substrate: "event"
    naming::
      mode: "content"
    description: "A session ended, with how far each of its streams had got."
    schema::
      additionalProperties: false
      required:: "session", "outcome", "through"
      nonEmpty::
        - "reason"
      properties::
        session::
          use: "core.IdentityUri"
        outcome::
          use: "SessionOutcome"
        through::
          use: "Frontier"
        reason::
          type: "string"
        details::
          use: "Details"

  Observation::
    substrate: "event"
    naming::
      mode: "content"
    description: "Something the issuer saw that no other kind describes, under a topic it names. A topic is a short fixed word, never free text; what was seen is behind the content references."
    schema::
      additionalProperties: false
      required:: "topic", "contentRefs"
      properties::
        topic::
          type: "string"
          pattern: "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)*$"
          maxLength: 128
        contentRefs::
          type: "array"
          unique: true
          items::
            use: "core.ExactRef"
        about::
          use: "core.IdentityUri"
        details::
          use: "Details"

  PublishedView::
    substrate: "event"
    naming::
      mode: "content"
    description: "A rendered view was published."
    schema::
      additionalProperties: false
      required::
        - "viewRef"
      properties::
        viewRef::
          use: "core.BytesRef"
        about::
          use: "core.ExactRef"

  EpochSeal::
    substrate: "event"
    naming::
      mode: "content"
    description: "A seal over a run of positions in one stream: the Merkle root of their records and the manifest that lists them. `previousSeal` is absent only on a stream's first seal."
    schema::
      additionalProperties: false
      required:: "stream", "firstSeq", "lastSeq", "root", "manifestRef"
      ordered::
        - ::
          - "firstSeq"
          - "lastSeq"
      properties::
        stream::
          use: "core.IdentityUri"
        firstSeq::
          use: "Position"
        lastSeq::
          use: "Position"
        previousSeal::
          use: "core.EvidenceRef"
        root::
          use: "core.Digest"
        manifestRef::
          use: "core.BytesRef"

  Checkpoint::
    substrate: "event"
    naming::
      mode: "content"
    description: "A roll-up over seals."
    schema::
      additionalProperties: false
      required::
        - "seals"
      nonEmpty::
        - "seals"
      properties::
        seals::
          type: "array"
          unique: true
          items::
            use: "core.EvidenceRef"
        previous::
          use: "core.EvidenceRef"
        snapshot::
          use: "Snapshot"

  RetentionHold::
    substrate: "event"
    naming::
      mode: "content"
    description: "Named content or records, or everything recorded under one scope, must be kept until this is released or its time has passed. A hold by scope covers what is recorded under that scope afterwards as well."
    schema::
      additionalProperties: false
      required::
        - "reason"
      nonEmpty:: "targets", "reason"
      exactlyOne::
        - :: "targets", "scope"
      properties::
        targets::
          type: "array"
          unique: true
          items::
            use: "core.ExactRef"
        scope::
          use: "core.IdentityUri"
          description: "A content scope: a session, or a stream written as stream: followed by its name."
        reason::
          type: "string"
        until::
          use: "core.Timestamp"
        details::
          use: "Details"

  RetentionHoldRelease::
    substrate: "event"
    naming::
      mode: "content"
    signatures: 2
    description: "An earlier hold no longer applies. Signed by the recorder and then by the person or service releasing it, whose key is not the recorder's, so that whoever holds the recorder's key alone cannot release a hold."
    schema::
      additionalProperties: false
      required:: "hold", "releasedBy", "reason"
      nonEmpty::
        - "reason"
      properties::
        hold::
          use: "core.EvidenceRef"
        releasedBy::
          use: "core.KeyId"
          matchesSigner: 2
        reason::
          type: "string"
        details::
          use: "Details"

  PayloadDisposition::
    substrate: "event"
    naming::
      mode: "content"
    description: "Content expired, was deleted, or was restored: named content or records, or everything recorded under one scope."
    schema::
      additionalProperties: false
      required:: "action", "reason"
      nonEmpty:: "targets", "reason"
      exactlyOne::
        - :: "targets", "scope"
      properties::
        targets::
          type: "array"
          unique: true
          items::
            use: "core.ExactRef"
        scope::
          use: "core.IdentityUri"
          description: "A content scope: a session, or a stream written as stream: followed by its name."
        action::
          type: "string"
          enum:: "expired", "deleted", "restored"
        reason::
          type: "string"
        details::
          use: "Details"

  Disclosure::
    substrate: "event"
    naming::
      mode: "content"
    description: "Evidence was provided to someone. Either named pieces were asked for, and the record says which were provided; or a whole session was provided, and the record says which of its content was withheld."
    schema::
      additionalProperties: false
      required:: "recipient", "outcome"
      nonEmpty::
        - "reason"
      exactlyOne::
        - :: "scope", "requestedRefs"
        - :: "scope", "providedRefs"
        - :: "requestedRefs", "excluding"
      properties::
        requestedRefs::
          type: "array"
          unique: true
          items::
            use: "core.ExactRef"
        providedRefs::
          type: "array"
          unique: true
          items::
            use: "core.ExactRef"
        scope::
          type: "string"
          description: "The session provided whole. Everything recorded in it up to its close is covered, except what `excluding` names."
          pattern: "^urn:r5e:session:[^\\s]+$"
          maxLength: 1024
        excluding::
          type: "array"
          description: "What of the session was withheld, by reference: a record left out whole, or content left out of a record that was provided. Present with `scope` even when empty, so that nothing withheld is told apart from nothing said."
          unique: true
          items::
            use: "core.ExactRef"
        recipient::
          use: "core.IdentityUri"
        outcome::
          type: "string"
          enum:: "provided", "partial", "denied"
        policy::
          use: "PolicyEvaluation"
        reason::
          type: "string"
        details::
          use: "Details"

  Verification::
    substrate: "event"
    naming::
      mode: "content"
    description: "Someone verified named evidence and where their report is."
    schema::
      additionalProperties: false
      required:: "targetRefs", "verifierRef", "reportRef", "outcome"
      nonEmpty::
        - "targetRefs"
      properties::
        targetRefs::
          type: "array"
          unique: true
          items::
            use: "core.ExactRef"
        verifierRef::
          use: "core.ExactRef"
        reportRef::
          use: "core.BytesRef"
        outcome::
          type: "string"
          enum:: "valid", "invalid", "incomplete", "unsupported"

  DefinitionPublished::
    substrate: "event"
    naming::
      mode: "content"
    description: "A publisher states which definition documents it issues for which kinds. The definition itself is identified by its content; this record is how a reader tells whose it is."
    schema::
      additionalProperties: false
      required::
        - "definitions"
      nonEmpty::
        - "definitions"
      properties::
        definitions::
          type: "array"
          unique: true
          items::
            type: "object"
            additionalProperties: false
            required:: "kind", "definition"
            properties::
              kind::
                use: "core.KindPath"
              definition::
                use: "core.BytesRef"
        package::
          type: "string"
        manifestRef::
          use: "core.BytesRef"
        previous::
          use: "core.EvidenceRef"
        proposal::
          type: "ref"
          description: "The record these definitions were proposed in, on this chain or another. Naming it says the publisher accepted that proposal; it gives the proposal's author no authority."
          ref::
            evidence: true
            crossChain: true
        details::
          use: "Details"

  # ---- Who a key is, who vouches for it, and how that ends ----
  #
  # These five are how authority is written down. Nothing here decides
  # whether a reader trusts a key: a reader starts from keys it chose and
  # follows these records outward.

  Principal::
    substrate: "event"
    naming::
      mode: "content"
    description: "A key introduces itself: its public key, what kind of thing holds it, and how it is kept. Signed by that key, so the record proves the holder has it. It claims nothing about authority."
    schema::
      additionalProperties: false
      required:: "key", "publicKey", "holder"
      properties::
        key::
          use: "core.KeyId"
          matchesSigner: 1
          derives::
            keyIdOf: "publicKey"
        publicKey::
          use: "core.PublicKey"
        holder::
          type: "string"
          description: "What holds the key. Open: an issuer may use other words."
          pattern: "^[a-z][a-z0-9-]*$"
        custody::
          type: "string"
          description: "How the private key is kept, as the holder states it: for example hardware, kms, host, software."
          pattern: "^[a-z][a-z0-9-]*$"
        identity::
          use: "core.IdentityUri"
        details::
          use: "Details"

  Endorsement::
    substrate: "event"
    naming::
      mode: "content"
    description: "The issuer vouches for another key: what kinds of record it may issue, in which streams, between which instants, and whether it may vouch for others in turn. `parent` is the endorsement the issuer's own standing comes from; a root has none."
    schema::
      additionalProperties: false
      required:: "subject", "kinds", "mayEndorse", "notBefore", "notAfter"
      nonEmpty:: "kinds", "streamPrefixes", "actorPrefixes", "role"
      ordered::
        - ::
          - "notBefore"
          - "notAfter"
      properties::
        subject::
          use: "core.KeyId"
        role::
          type: "string"
        kinds::
          type: "array"
          unique: true
          description: "The kind paths the subject may issue, each named in full. There is no wildcard: a grant never covers a kind its author did not name."
          items::
            use: "core.KindPath"
        streamPrefixes::
          type: "array"
          unique: true
          description: "Streams the subject may write to, by prefix. Absent means no narrower than the grant above it."
          items::
            type: "string"
            pattern: "^.+$"
        actorPrefixes::
          type: "array"
          unique: true
          description: "Who the subject may name as the actor of a record, by prefix. Absent means no narrower than the grant above it."
          items::
            type: "string"
            pattern: "^.+$"
        actsFor::
          use: "core.IdentityUri"
        mayEndorse::
          type: "boolean"
        notBefore::
          use: "core.Timestamp"
        notAfter::
          use: "core.Timestamp"
        parent::
          use: "core.EvidenceRef"
        details::
          use: "Details"

  Badge::
    substrate: "event"
    naming::
      mode: "content"
    signatures: 2
    description: "A short-lived credential the issuer gives a workload or an agent's session key. The subject signs second, which proves it holds the key the badge names. A badge never lets its subject vouch for others."
    schema::
      additionalProperties: false
      required:: "subject", "subjectKey", "holder", "kinds", "notBefore", "notAfter", "parent"
      nonEmpty:: "kinds", "streamPrefixes", "actorPrefixes"
      ordered::
        - ::
          - "notBefore"
          - "notAfter"
      properties::
        subject::
          use: "core.KeyId"
          matchesSigner: 2
          derives::
            keyIdOf: "subjectKey"
        subjectKey::
          use: "core.PublicKey"
        holder::
          type: "string"
          pattern: "^[a-z][a-z0-9-]*$"
        kinds::
          type: "array"
          unique: true
          items::
            use: "core.KindPath"
        streamPrefixes::
          type: "array"
          unique: true
          description: "Streams the subject may write to, by prefix. Absent means no narrower than the grant above it."
          items::
            type: "string"
            pattern: "^.+$"
        actorPrefixes::
          type: "array"
          unique: true
          description: "Who the subject may name as the actor of a record, by prefix. Absent means no narrower than the grant above it."
          items::
            type: "string"
            pattern: "^.+$"
        actsFor::
          use: "core.IdentityUri"
        workload::
          use: "core.IdentityUri"
        notBefore::
          use: "core.Timestamp"
        notAfter::
          use: "core.Timestamp"
        parent::
          use: "core.EvidenceRef"
        details::
          use: "Details"

  Succession::
    substrate: "event"
    naming::
      mode: "content"
    signatures: 2
    description: "One key hands over to another. Signed by the old key and then by the new, so neither can be replaced without the other. What the old key was vouched for passes to the new from this record on."
    schema::
      additionalProperties: false
      required:: "predecessor", "successor", "successorKey"
      nonEmpty::
        - "reason"
      properties::
        predecessor::
          use: "core.KeyId"
          matchesSigner: 1
        successor::
          use: "core.KeyId"
          matchesSigner: 2
          derives::
            keyIdOf: "successorKey"
        successorKey::
          use: "core.PublicKey"
        reason::
          type: "string"
        details::
          use: "Details"

  Revocation::
    substrate: "event"
    naming::
      mode: "content"
    description: "The issuer takes back an endorsement or a badge. It counts from when a reader can show it was recorded; it does not reach back before that."
    schema::
      additionalProperties: false
      required:: "target"
      nonEmpty::
        - "reason"
      properties::
        target::
          use: "core.EvidenceRef"
        reason::
          type: "string"
        details::
          use: "Details"

  ChainStarted::
    substrate: "event"
    naming::
      mode: "content"
    description: "The first record of a deployment's start stream. Signed by the bootstrap key the node made for itself, before any customer key exists. It states which published definitions the node built itself from, which is the exact version of the API, and carries the bootstrap key."
    schema::
      additionalProperties: false
      required:: "deployment", "bootstrap", "bootstrapKey", "publication", "publisher", "definitions"
      nonEmpty::
        - "definitions"
      properties::
        deployment::
          type: "string"
          description: "The deployment's name, as it appears in its stream names."
          pattern: "^[a-z0-9][a-z0-9-]*$"
        bootstrap::
          use: "core.KeyId"
          matchesSigner: 1
          derives::
            keyIdOf: "bootstrapKey"
        bootstrapKey::
          use: "core.PublicKey"
        publication::
          use: "core.EvidenceRef"
          description: "The DefinitionPublished record the node took its definitions from."
        publisher::
          use: "core.KeyId"
          description: "The key that signed that publication."
        definitions::
          type: "array"
          unique: true
          items::
            type: "object"
            additionalProperties: false
            required:: "kind", "definition"
            properties::
              kind::
                use: "core.KindPath"
              definition::
                use: "core.BytesRef"
        details::
          use: "Details"

  Deployment::
    substrate: "event"
    naming::
      mode: "content"
    signatures: 2
    description: "The second record of a deployment's start stream, and the first thing the customer attests. Signed by the bootstrap key and then by one of the customer's root keys. It accepts the start record before it and names the customer's roots, how many must act together, and any recovery keys. Its reference is the chain's name. After it the bootstrap key has no authority."
    schema::
      additionalProperties: false
      required:: "accepts", "bootstrap", "claimedBy", "roots", "threshold"
      nonEmpty:: "roots", "recoveryKeys", "custodians"
      properties::
        accepts::
          use: "core.EvidenceRef"
          description: "The ChainStarted record at position 1 of this stream."
        bootstrap::
          use: "core.KeyId"
          matchesSigner: 1
        claimedBy::
          use: "core.KeyId"
          matchesSigner: 2
          description: "The root key that signs this record for the customer. It must be one of the roots listed."
        roots::
          type: "array"
          unique: true
          items::
            type: "object"
            additionalProperties: false
            required:: "key", "publicKey"
            properties::
              key::
                use: "core.KeyId"
                derives::
                  keyIdOf: "publicKey"
              publicKey::
                use: "core.PublicKey"
              holder::
                type: "string"
                pattern: "^[a-z][a-z0-9-]*$"
              custody::
                type: "string"
                pattern: "^[a-z][a-z0-9-]*$"
              identity::
                use: "core.IdentityUri"
        threshold::
          type: "integer"
          description: "How many of the roots must act together to change these terms."
          minimum: 1
        recoveryKeys::
          type: "array"
          unique: true
          description: "Key ids of recovery keys. A key id is a fingerprint of the public key, so the key itself stays unrevealed until it is used."
          items::
            use: "core.KeyId"
        custodians::
          type: "array"
          unique: true
          description: "The people who may approve a change of roots. A person is named first; their own key may be given here or bound to them later."
          items::
            type: "object"
            additionalProperties: false
            required::
              - "identity"
            properties::
              identity::
                use: "core.IdentityUri"
              key::
                use: "core.KeyId"
        details::
          use: "Details"

  RootsChanged::
    substrate: "event"
    naming::
      mode: "content"
    description: "A later record of a deployment's start stream: the customer replaces the roots, the number that must act together, the recovery keys or the people who may approve. It is signed by one key, either a recovery key the terms before it declared, which needs nothing more, or one of the roots then in force, which needs the approvals those terms require. It carries its signer's public key, so a recovery key is first revealed by the record that uses it."
    schema::
      additionalProperties: false
      required:: "chain", "replaces", "authorization", "signer", "signerKey", "roots", "threshold"
      nonEmpty:: "roots", "recoveryKeys", "custodians", "reason"
      properties::
        chain::
          use: "core.EvidenceRef"
          description: "The deployment record that names this chain. It never changes."
        replaces::
          use: "core.EvidenceRef"
          description: "The start record before this one, whose terms this replaces."
        authorization::
          type: "string"
          enum:: "quorum", "recovery"
        signer::
          use: "core.KeyId"
          matchesSigner: 1
          derives::
            keyIdOf: "signerKey"
        signerKey::
          use: "core.PublicKey"
        roots::
          type: "array"
          unique: true
          items::
            type: "object"
            additionalProperties: false
            required:: "key", "publicKey"
            properties::
              key::
                use: "core.KeyId"
                derives::
                  keyIdOf: "publicKey"
              publicKey::
                use: "core.PublicKey"
              holder::
                type: "string"
                pattern: "^[a-z][a-z0-9-]*$"
              custody::
                type: "string"
                pattern: "^[a-z][a-z0-9-]*$"
              identity::
                use: "core.IdentityUri"
        threshold::
          type: "integer"
          minimum: 1
        recoveryKeys::
          type: "array"
          unique: true
          items::
            use: "core.KeyId"
        custodians::
          type: "array"
          unique: true
          items::
            type: "object"
            additionalProperties: false
            required::
              - "identity"
            properties::
              identity::
                use: "core.IdentityUri"
              key::
                use: "core.KeyId"
        reason::
          type: "string"
        details::
          use: "Details"

  RootChangeApproval::
    substrate: "event"
    naming::
      mode: "content"
    signatures: 2
    description: "One approval of one change of roots. Signed by one of the roots in force and then by the personal key of the person who holds it, so every approval is a root and a named person together. It cites the change by its reference, which fixes the change's position and terms, so an approval cannot be moved to another change."
    schema::
      additionalProperties: false
      required:: "change", "root", "custodian", "custodianKey", "custodianPublicKey"
      nonEmpty::
        - "reason"
      properties::
        change::
          use: "core.EvidenceRef"
        root::
          use: "core.KeyId"
          matchesSigner: 1
        custodian::
          use: "core.IdentityUri"
        custodianKey::
          use: "core.KeyId"
          matchesSigner: 2
          derives::
            keyIdOf: "custodianPublicKey"
        custodianPublicKey::
          use: "core.PublicKey"
        reason::
          type: "string"
        details::
          use: "Details"
