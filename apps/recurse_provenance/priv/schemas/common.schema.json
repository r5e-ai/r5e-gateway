{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r5e.io/proposals/provenance-v2/schemas/common.schema.json",
  "title": "Provenance v2 common values",
  "$defs": {
    "ExactRef": {
      "type": "string",
      "pattern": "^(?:evidence|bytes|event):sha256:[0-9a-f]{64}$"
    },
    "EvidenceRef": {
      "type": "string",
      "pattern": "^evidence:sha256:[0-9a-f]{64}$"
    },
    "BytesRef": {
      "type": "string",
      "pattern": "^bytes:sha256:[0-9a-f]{64}$"
    },
    "EventRef": {
      "type": "string",
      "pattern": "^event:sha256:[0-9a-f]{64}$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "IdentityURI": {
      "type": "string",
      "format": "uri",
      "pattern": "^(?!evidence:|bytes:|event:|attachment:)[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
      "$comment": "The selected profile declares which stable URI schemes/identities it accepts; syntax is not authentication."
    },
    "KeyID": {
      "type": "string",
      "pattern": "^key:[a-z0-9-]+:sha256:[0-9a-f]{64}$"
    },
    "Position": {
      "type": "integer",
      "minimum": 1
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "UTCTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "Base64": {
      "type": "string",
      "contentEncoding": "base64",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "$comment": "Canonical pad bits and decoded content require semantic checking."
    },
    "AttachmentRef": {
      "type": "string",
      "pattern": "^attachment:[^\\s]+$",
      "$comment": "Request-local token only; name must resolve uniquely and normalize to a bytes: ref before final validation/signing."
    },
    "JSONValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JSONValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      ],
      "$comment": "Core additionally rejects lexical floating-point numbers, duplicate keys and invalid Unicode; ordinary JSON Schema operates on already parsed values."
    },
    "ResponseOutcome": {
      "enum": [
        "completed",
        "failed",
        "denied",
        "cancelled",
        "partial",
        "unknown"
      ]
    },
    "SessionOutcome": {
      "enum": [
        "completed",
        "interrupted",
        "failed",
        "unknown"
      ]
    },
    "FrontierEntry": {
      "type": "object",
      "properties": {
        "stream": {
          "$ref": "common.schema.json#/$defs/IdentityURI"
        },
        "seq": {
          "$ref": "common.schema.json#/$defs/Position"
        },
        "event": {
          "$ref": "common.schema.json#/$defs/EvidenceRef"
        }
      },
      "required": [
        "stream",
        "seq",
        "event"
      ],
      "additionalProperties": false
    },
    "Frontier": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FrontierEntry"
      },
      "uniqueItems": true,
      "$comment": "Sort by stream ID; exactly one head per stream. JSON Schema cannot enforce uniqueness by stream or cross-record agreement."
    }
  }
}
